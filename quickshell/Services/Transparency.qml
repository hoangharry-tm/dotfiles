pragma Singleton

import QtQuick
import Quickshell

// "Reduce transparency" (Settings.reduceTransparency): shell sheets go solid
// (Theme.glass / glassSolid) and niri stops blurring them, since blur under an
// opaque sheet is pure GPU cost. Shell surfaces only (`qs-*` layers): app
// windows such as terminals keep their own opacity and blur, as in Apple's
// setting, which is about system materials. Written to a niri include that
// config.kdl pulls in beside niri-power.kdl.
Singleton {
    id: root

    readonly property bool reduce: Settings.reduceTransparency

    NiriInclude {
        name: "niri-transparency.kdl"
        content: root.reduce ? ["// generated by Services/Transparency.qml: reduce transparency", "layer-rule {", "    match namespace=\"^qs-\"", "    background-effect {", "        blur false", "    }", "}", ""].join("\n") : ""
    }
}
