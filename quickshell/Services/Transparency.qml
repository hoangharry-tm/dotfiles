pragma Singleton

import QtQuick
import Quickshell

// "Reduce transparency" (Settings.reduceTransparency): shell sheets go solid
// (Theme.glass / glassSolid) and niri stops blurring them, since blur under an
// opaque sheet is pure GPU cost. Shell surfaces (`qs-*` layers) plus Firefox,
// whose chrome is the same glass material (matugen firefox.css); terminals
// keep their own opacity and blur, as in Apple's setting, which is about
// system materials. Written to a niri include that config.kdl pulls in beside
// niri-power.kdl (after rules.kdl, so the Firefox rule overrides its blur),
// and to firefox-solid.css, which userChrome.css imports (modules/browser.nix;
// Firefox reads it at startup).
Singleton {
    id: root

    readonly property bool reduce: Settings.reduceTransparency

    NiriInclude {
        name: "niri-transparency.kdl"
        content: root.reduce ? ["// generated by Services/Transparency.qml: reduce transparency", "layer-rule {", "    match namespace=\"^qs-\"", "    background-effect {", "        blur false", "    }", "}", "window-rule {", "    match app-id=\"^firefox$\"", "    background-effect {", "        blur false", "    }", "}", ""].join("\n") : ""
    }

    // Same helper (write-if-changed state file); --mg-glass-pct is the
    // template's single glass-alpha knob.
    NiriInclude {
        name: "firefox-solid.css"
        content: root.reduce ? "/* generated by Services/Transparency.qml: reduce transparency */\n:root { --mg-glass-pct: 100% !important; }\n" : ""
    }
}
