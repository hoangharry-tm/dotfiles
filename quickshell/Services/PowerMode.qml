pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Services.UPower

// Low-power mode: on battery with Settings.lowPower "auto", or forced with
// "always". One flag drives every saving: shell motion (Theme.motionScale),
// Ambient drift, cava, desktop now-playing, the niri override file and the
// power profile. Consumers just bind to `lowPower`.
Singleton {
    id: root

    readonly property bool lowPower: Settings.lowPower === "always" || (Settings.lowPower === "auto" && Power.hasBattery && !Power.plugged)

    readonly property string niriFile: (Quickshell.env("XDG_STATE_HOME") || Quickshell.env("HOME") + "/.local/state") + "/theme/niri-power.kdl"

    // Last in config.kdl, so it overrides look.kdl/rules.kdl. Empty = no override.
    // Blur is the iGPU's biggest cost; the catch-all rules sit after the per-app
    // ones so they win. Animations slow down 5x (near-instant).
    readonly property string niriOverride: lowPower ? ["// generated by Services/PowerMode.qml: low power", "animations {", "    slowdown 0.2", "}", "window-rule {", "    background-effect {", "        blur false", "    }", "    popups {", "        background-effect {", "            blur false", "        }", "    }", "}", "layer-rule {", "    background-effect {", "        blur false", "    }", "    popups {", "        background-effect {", "            blur false", "        }", "    }", "}", ""].join("\n") : ""

    // Write only when the content actually changes: every write makes niri
    // reload its whole config, which briefly drops window blur (a visible
    // frosted -> clear -> frosted flicker). Shell restarts used to rewrite it.
    function writeNiri() {
        if (niri.ready && niri.text() === niriOverride)
            return;
        niri.setText(niriOverride);
    }
    onNiriOverrideChanged: if (niri.ready || niri.missing)
        writeNiri()

    FileView {
        id: niri

        property bool ready: false   // read once: compare before writing
        property bool missing: false // no file yet: first write creates it

        path: root.niriFile
        atomicWrites: true
        printErrors: false
        onLoaded: {
            ready = true;
            root.writeNiri();
        }
        onLoadFailed: {
            missing = true;
            root.writeNiri();
        }
    }

    // Power profile: switch to power-saver, restore the user's previous one
    // after. A manual change while in low power wins and is not restored over.
    property int _saved: -1          // profile to restore, -1 = none
    property bool _userChanged: false

    onLowPowerChanged: {
        if (lowPower) {
            _userChanged = false;
            _saved = Power.profile;
            if (Power.profile !== PowerProfile.PowerSaver)
                Power.setProfile(PowerProfile.PowerSaver);
            else
                _saved = -1; // already saver: nothing to give back
        } else {
            if (!_userChanged && _saved >= 0 && Power.profile === PowerProfile.PowerSaver)
                Power.setProfile(_saved);
            _saved = -1;
        }
    }

    Connections {
        target: Power

        function onProfileChanged() {
            if (root.lowPower && root._saved >= 0 && Power.profile !== PowerProfile.PowerSaver)
                root._userChanged = true;
        }
    }
}
