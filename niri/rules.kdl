// https://niri-wm.github.io/niri/Configuration:-Window-Rules
// https://niri-wm.github.io/niri/Configuration:-Layer-Rules

// Every window: rounded corners, content clipped to them, and the focus
// ring drawn around (not behind) the window so translucent windows aren't
// tinted.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// Depth shows focus: inactive windows sit one step lower than the active
// one (E2 -> E1-like: tighter, nearer shadow), so the focused window lifts
// toward you without any outline (look.kdl: focus-ring off).
window-rule {
    match is-active=false
    shadow {
        softness 24
        offset x=0 y=4
    }
}

// Glass app windows: translucent apps get the shared blur from look.kdl
// (`blur {}`; `blur { off }` there disables all of it). Radius 12 comes from
// the catch-all rule at the top, so the blur follows the rounded corners.
// Opaque apps (browsers, video) are deliberately not listed: blur would cost
// GPU for nothing.
window-rule {
    match app-id="^Alacritty$"
    match app-id="^kitty$"
    match app-id="^dropdown$"
    match app-id="^yazi$"
    background-effect {
        blur true
    }
}

// Glass popups: right-click / context menus (xdg-popup) of every window, GTK,
// Qt and Firefox alike. Popover level per DESIGN.md: radius 12 (Theme.radiusMd,
// menus are small cards), slight transparency so the blur reads but text keeps
// contrast. Menus draw their own shadow, niri adds none to popups.
window-rule {
    popups {
        opacity 0.94
        geometry-corner-radius 12
        background-effect {
            blur true
        }
    }
}

// Work around WezTerm's initial configure bug.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Quick-settings popups from the Control Center (nmtui, bluetui, wiremix):
// a floating glass terminal, centered.
window-rule {
    match app-id="^popup$"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 520; }
    background-effect {
        blur true
    }
}

// Floating utilities: small, single-purpose windows that should not join the
// scrolling tiling layout. Centered by niri when no position is given.
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^blueman-manager"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^(qalculate-gtk|org\.qalculate\.qalculate-gtk)$"#
    match app-id=r#"^org\.gnome\.(Settings|Characters)$"#
    match app-id=r#"^com\.saivert\.pwvucontrol$"#
    open-floating true
}

// LocalSend (AirDrop-like): a small floating utility, not a tiled column.
window-rule {
    match app-id=r#"^(localsend_app|org\.localsend\.localsend_app)$"#
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 520; }
}

// Dialogs and pickers: file choosers (xdg-desktop-portal-gtk), browser
// save/upload dialogs, and any window that declares itself a dialog child.
window-rule {
    match app-id=r#"^xdg-desktop-portal"#
    match title=r#"^(Open|Save)( File| As| Files)?$"#
    match title=r#"^(File Upload|Select a File|Choose Files?)"#
    open-floating true
    default-column-width { fixed 880; }
    default-window-height { fixed 560; }
}

// Authentication prompts: floating and kept out of screen recordings.
window-rule {
    match app-id=r#"polkit"#
    open-floating true
    block-out-from "screencast"
}

// Password managers: never leak into screencasts or screen sharing.
window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|com\.bitwarden\.desktop|1Password)$"#
    block-out-from "screencast"
}

// Image viewers: float at a comfortable size instead of taking a column.
window-rule {
    match app-id=r#"^(org\.gnome\.(Loupe|eog)|imv|feh|sxiv|nsxiv|org\.kde\.gwenview)$"#
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 640; }
}

// Browsers get two thirds of the screen (terminals keep the 0.5 default).
// Before the PiP rule so its fixed size still wins.
window-rule {
    match app-id=r#"^(firefox|chromium|google-chrome)"#
    default-column-width { proportion 0.66667; }
}

// Spotify lives on the named workspace "music" (declared here; niri keeps
// named workspaces alive when empty).
// Pinned with open-on-output: niri moves a named workspace to the remaining
// monitor on unplug (windows come along, appended after that monitor's own
// workspaces) and back when its output reappears. Unnamed ones aren't restored.
// Media and scratch on the laptop panel, a "main" dev workspace on the monitor.
workspace "music" {
    open-on-output "eDP-1"
}
workspace "main" {
    open-on-output "HDMI-A-2"
}
window-rule {
    match app-id="^spotify$"
    open-on-workspace "music"
}

// Dropdown terminal (`dropdown-term`, bound in binds.kdl): 60% x 50%, hung
// from the top edge. Parked on "scratch" while hidden; niri has no minimise.
workspace "scratch" {
    open-on-output "eDP-1"
}
window-rule {
    match app-id="^dropdown$"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.5; }
    default-floating-position x=0 y=12 relative-to="top"
}

// Picture-in-picture (Firefox, Chrome): floating in the bottom-right corner
// of the focused output, small enough not to cover content. Floating
// windows are always drawn above tiled ones.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"^(chromium|google-chrome)"# title="(?i)^picture in picture$"
    open-floating true
    default-floating-position x=24 y=24 relative-to="bottom-right"
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// Quickshell surfaces (~/.config/quickshell): frosted glass, radii matching
// the QML sheets (Theme.radius*) and the shadows to the
// elevation levels in quickshell/DESIGN.md; keep them in sync. Toasts are a stack of cards in one surface, so they
// use a more opaque fill instead of blur.
layer-rule {
    match namespace="^qs-bar$"
    geometry-corner-radius 12
    background-effect {
        blur true
    }
    // elevation E1 (quickshell/DESIGN.md)
    shadow {
        on
        softness 24
        spread 0
        offset x=0 y=2
        color "#00000033"
    }
}

// Bar hover cards (quickshell Widgets/Popover.qml).
layer-rule {
    match namespace="^qs-popover$"
    geometry-corner-radius 16
    background-effect {
        blur true
    }
    // elevation E2 (quickshell/DESIGN.md)
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=8
        color "#00000040"
    }
}

layer-rule {
    match namespace="^qs-control-center$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E2 (quickshell/DESIGN.md)
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=8
        color "#00000040"
    }
}

layer-rule {
    match namespace="^qs-calendar$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E2 (quickshell/DESIGN.md)
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=8
        color "#00000040"
    }
}

layer-rule {
    match namespace="^qs-launcher$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E3 (quickshell/DESIGN.md)
    shadow {
        on
        softness 64
        spread 0
        offset x=0 y=16
        color "#00000047"
    }
}

// Dock (quickshell Modules/Dock): floating sheet at the bottom centre.
layer-rule {
    match namespace="^qs-dock$"
    geometry-corner-radius 16
    background-effect {
        blur true
    }
    // elevation E2 (quickshell/DESIGN.md)
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=8
        color "#00000040"
    }
}

// Alt+Tab switcher (quickshell Modules/Switcher).
layer-rule {
    match namespace="^qs-switcher$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E3 (quickshell/DESIGN.md)
    shadow {
        on
        softness 64
        spread 0
        offset x=0 y=16
        color "#00000047"
    }
}

layer-rule {
    match namespace="^qs-polkit$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E3 (quickshell/DESIGN.md): modal, like the launcher
    shadow {
        on
        softness 64
        spread 0
        offset x=0 y=16
        color "#00000047"
    }
}

layer-rule {
    match namespace="^qs-osd$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E2 (quickshell/DESIGN.md)
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=8
        color "#00000040"
    }
}

// Power menu: frost the whole screen.
layer-rule {
    match namespace="^qs-power$"
    background-effect {
        blur true
    }
}

// Keep the wallpaper visible behind the workspaces in the overview.
layer-rule {
    match namespace="^awww-daemon"
    place-within-backdrop true
}

layer-rule {
    match namespace="^qs-keybinds$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E3 (quickshell/DESIGN.md): large modal sheet
    shadow {
        on
        softness 64
        spread 0
        offset x=0 y=16
        color "#00000047"
    }
}

layer-rule {
    match namespace="^qs-settings$"
    geometry-corner-radius 28
    background-effect {
        blur true
    }
    // elevation E3 (quickshell/DESIGN.md): large modal sheet
    shadow {
        on
        softness 64
        spread 0
        offset x=0 y=16
        color "#00000047"
    }
}

// Popups of layer-shell clients (qs-* sheets, tray menus): same glass.
layer-rule {
    popups {
        opacity 0.94
        geometry-corner-radius 12
        background-effect {
            blur true
        }
    }
}
