// niri — minimal, glassy, quiet.
// Docs: https://niri-wm.github.io/niri/Configuration:-Introduction
//
// Split by concern; each file is merged in order (later files override).
// Colors are generated from the wallpaper by matugen (`wallpaper set <img>`)
// into ~/.local/state/theme/niri.kdl, which is included last.

include "input.kdl"
include "look.kdl"
include "rules.kdl"
include "startup.kdl"
include "binds.kdl"

// Hardware-scaled motion tier (modules/motion.nix: `motion-tier`); overrides look.kdl animations/blur.
include optional=true "~/.local/state/motion/niri.kdl"

include optional=true "~/.local/state/theme/niri.kdl"

// Reduce transparency (blur off for qs-* sheets); written by quickshell's Transparency, empty otherwise.
include optional=true "~/.local/state/theme/niri-transparency.kdl"

// Low-power override (blur off, short animations); written by quickshell's PowerMode, empty otherwise. Keep last.
include optional=true "~/.local/state/theme/niri-power.kdl"
