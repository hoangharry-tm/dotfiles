// Look & feel: minimal (Muji), glassy and precise (Apple).
// Colors live in the generated theme file; only geometry and motion here.

layout {
    // The wallpaper lives in the backdrop (rules.kdl: place-within-backdrop),
    // so let it show through workspaces instead of niri's default gray.
    background-color "transparent"

    gaps 12
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // A thin accent hairline instead of a heavy border.
    focus-ring {
        width 2
    }
    border {
        off
    }

    // Tabbed columns (Mod+W): a slim pill beside the tabs, hidden when alone.
    tab-indicator {
        hide-when-single-tab
        place-within-column
        width 4
        gap 6
        corner-radius 2
        length total-proportion=0.5
    }

    // Windows sit at elevation E2 (same as popovers; see quickshell/DESIGN.md):
    // wide, low-alpha, no spread, so it blends instead of outlining.
    shadow {
        on
        softness 48
        spread 0
        offset x=0 y=8
        color "#00000047"
    }
}

// Frosted glass for surfaces that opt in (see rules.kdl).
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.4
}

// Ask apps to drop their own title bars; niri then knows the exact window
// shape and draws rings/shadows around it cleanly.
prefer-no-csd

cursor {
    // Installed by modules/theming.nix (home.pointerCursor); keep in sync.
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
    hide-when-typing
}

// Overview: windows a little smaller so the wallpaper has room to breathe.
overview {
    zoom 0.5
    // backdrop-color comes from the matugen include (theme/niri.kdl). A soft
    // E2-style shadow lifts each workspace off the backdrop.
    workspace-shadow {
        softness 40
        spread 0
        offset x=0 y=8
        color "#00000040"
    }
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// One motion language shared with the shell (quickshell Theme motion tokens):
// entrances decelerate (cubic-bezier 0.05 0.7 0.1 1 = Theme.curveDecelerate),
// exits accelerate (0.3 0 0.8 0.15 = Theme.curveAccelerate) and are shorter
// (Theme.animExit 150 / anim 220). Spatial changes (move, resize, scroll,
// workspace) are springs: critically damped, so no wobble, only stiffness
// varies; the bigger the move the stiffer. Windows scale+fade in/out via the
// custom shaders below; they only touch the window texture, so blur/shadow stay.
animations {
    window-open {
        duration-ms 220
        curve "cubic-bezier" 0.05 0.7 0.1 1
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                // grow from 94% around the center while fading in
                float s = mix(0.94, 1.0, niri_clamped_progress);
                vec3 c = vec3((coords_geo.xy - 0.5) / s + 0.5, 1.0);
                if (c.x < 0.0 || c.x > 1.0 || c.y < 0.0 || c.y > 1.0)
                    return vec4(0.0);
                vec3 t = niri_geo_to_tex * c;
                return texture2D(niri_tex, t.st) * niri_clamped_progress;
            }
        "
    }
    window-close {
        duration-ms 150
        curve "cubic-bezier" 0.3 0 0.8 0.15
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                // shrink to 96% while fading out
                float s = mix(1.0, 0.96, niri_clamped_progress);
                vec3 c = vec3((coords_geo.xy - 0.5) / s + 0.5, 1.0);
                if (c.x < 0.0 || c.x > 1.0 || c.y < 0.0 || c.y > 1.0)
                    return vec4(0.0);
                vec3 t = niri_geo_to_tex * c;
                return texture2D(niri_tex, t.st) * (1.0 - niri_clamped_progress);
            }
        "
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    screenshot-ui-open {
        duration-ms 180
        curve "cubic-bezier" 0.05 0.7 0.1 1
    }
    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=900 epsilon=0.001
    }
}
