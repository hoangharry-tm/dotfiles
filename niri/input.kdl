// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // Empty: niri reads layout from org.freedesktop.locale1
            // (`localectl set-x11-keymap`).
        }
        numlock
    }

    // Natural scrolling is off everywhere to match macOS with
    // "Natural scrolling" disabled.
    touchpad {
        tap
        dwt
        // Two-finger = right click, three-finger = middle, like macOS.
        click-method "clickfinger"
    }

    mouse {}

    trackpoint {}
}

// Outputs, in logical pixels (physical / scale). The HDMI monitor sits to
// the LEFT of the laptop: it spans x 0–1920 (scale 1), the laptop panel
// starts at x=1920 (1920 / 1.25 = 1536 logical wide). Top edges aligned.
// When the monitor is unplugged niri ignores its block and the laptop
// panel still works on its own.
output "HDMI-A-2" {
    scale 1
    position x=0 y=0
}

output "eDP-1" {
    position x=1920 y=0
}

// Gestures. Touchpad swipes are built into niri and not configurable: 3
// fingers move the view (up/down = workspaces, left/right = columns), 4
// fingers up/down open/close the overview. Content follows the fingers
// (Mac-like) independent of natural-scroll, so with natural scrolling off
// the wheel and the swipes still differ; the swipes feel like macOS.
gestures {
    // Drag a window to a screen edge: scroll the strip / switch workspace.
    dnd-edge-view-scroll {
        trigger-width 48
        delay-ms 100
        max-speed 1500
    }
    dnd-edge-workspace-switch {
        trigger-height 48
        delay-ms 100
        max-speed 1500
    }

    // Overview from the bottom-right corner of each output. Not top-left:
    // the bar sits on the top edge with the workspace pills at its left,
    // and a hot corner there fires whenever you aim at them. Bottom-right
    // is bar-free, away from the seam between the two monitors (the laptop
    // panel's left edge touches HDMI's right edge), and the PiP window rule
    // leaves a 24px margin there.
    hot-corners {
        bottom-right
    }
}
