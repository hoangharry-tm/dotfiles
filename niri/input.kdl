// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // Empty: niri reads layout from org.freedesktop.locale1
            // (`localectl set-x11-keymap`).
        }
        numlock
    }

    // Natural scrolling is off everywhere to match macOS with
    // "Natural scrolling" disabled.
    touchpad {
        tap
        dwt
        // Two-finger = right click, three-finger = middle, like macOS.
        click-method "clickfinger"
    }

    mouse {}

    trackpoint {}
}

// Outputs. The laptop panel keeps its auto-detected scale (1.25); the HDMI
// monitor sits to its right, at 1x, top-aligned. Absent outputs are ignored,
// so the laptop-only case is unaffected.
output "eDP-1" {
    position x=0 y=0
}

output "HDMI-A-2" {
    scale 1
    // eDP-1 is 1920 / 1.25 = 1536 logical pixels wide.
    position x=1536 y=0
}
