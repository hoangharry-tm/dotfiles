# Generated by matugen. Do not edit; see ~/.config/matugen.
# Sourced (if present) by ~/.config/neomutt/neomuttrc; truecolor hex.
set color_directcolor = yes
color normal        "{{colors.on_surface.default.hex}}"       "{{colors.surface.default.hex}}"
color indicator     "{{colors.on_primary_container.default.hex}}" "{{colors.primary_container.default.hex}}"
color tree          "{{colors.outline.default.hex}}"          "{{colors.surface.default.hex}}"
color status        "{{colors.on_surface_variant.default.hex}}" "{{colors.surface_container.default.hex}}"
color message       "{{colors.primary.default.hex}}"          "{{colors.surface.default.hex}}"
color error         "{{colors.red.default.hex}}"              "{{colors.surface.default.hex}}"
color search        "{{colors.on_tertiary_container.default.hex}}" "{{colors.tertiary_container.default.hex}}"
color markers       "{{colors.outline.default.hex}}"          "{{colors.surface.default.hex}}"
color tilde         "{{colors.outline.default.hex}}"          "{{colors.surface.default.hex}}"
color bold          "{{colors.on_surface.default.hex}}"       "{{colors.surface.default.hex}}"
color underline     "{{colors.primary.default.hex}}"          "{{colors.surface.default.hex}}"
color attachment    "{{colors.tertiary.default.hex}}"         "{{colors.surface.default.hex}}"
color signature     "{{colors.outline.default.hex}}"          "{{colors.surface.default.hex}}"
color hdrdefault    "{{colors.on_surface_variant.default.hex}}" "{{colors.surface.default.hex}}"
color header        "{{colors.primary.default.hex}}"          "{{colors.surface.default.hex}}" "^(From|Subject|To|Cc|Date):"
color quoted        "{{colors.outline.default.hex}}"             "{{colors.surface.default.hex}}"
color quoted1       "{{colors.on_surface_variant.default.hex}}"            "{{colors.surface.default.hex}}"
color quoted2       "{{colors.outline.default.hex}}"           "{{colors.surface.default.hex}}"
color quoted3       "{{colors.on_surface_variant.default.hex}}"          "{{colors.surface.default.hex}}"
color body          "{{colors.primary.default.hex}}"          "{{colors.surface.default.hex}}" "(https?|ftp)://[^ \"<>)]+"
color body          "{{colors.primary.default.hex}}"          "{{colors.surface.default.hex}}" "[[:alnum:]._%+-]+@[[:alnum:].-]+"
color index         bold "{{colors.primary.default.hex}}"          "{{colors.surface.default.hex}}" "~N"
color index         "{{colors.tertiary.default.hex}}"         "{{colors.surface.default.hex}}" "~F"
color index         "{{colors.outline.default.hex}}"          "{{colors.surface.default.hex}}" "~D"
color index_author  "{{colors.secondary.default.hex}}"        "{{colors.surface.default.hex}}" "~N"
color index_subject "{{colors.on_surface.default.hex}}"       "{{colors.surface.default.hex}}" "~N"
color sidebar_background "{{colors.on_surface_variant.default.hex}}" "{{colors.surface_container_low.default.hex}}"
color sidebar_ordinary   "{{colors.on_surface_variant.default.hex}}" "{{colors.surface_container_low.default.hex}}"
color sidebar_divider    "{{colors.outline_variant.default.hex}}" "{{colors.surface_container_low.default.hex}}"
color sidebar_indicator  "{{colors.on_primary_container.default.hex}}" "{{colors.primary_container.default.hex}}"
color sidebar_highlight  "{{colors.on_surface.default.hex}}" "{{colors.surface_container_low.default.hex}}"
color sidebar_new        bold "{{colors.primary.default.hex}}" "{{colors.surface_container_low.default.hex}}"
color sidebar_unread     bold "{{colors.primary.default.hex}}" "{{colors.surface_container_low.default.hex}}"
color sidebar_flagged    "{{colors.tertiary.default.hex}}" "{{colors.surface_container_low.default.hex}}"
