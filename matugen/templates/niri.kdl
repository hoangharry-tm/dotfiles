// Generated by matugen from {{image}}. Do not edit; see ~/.config/matugen.
layout {
    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
    }
    insert-hint {
        color "{{colors.primary.default.hex}}60"
    }
}

overview {
    // = Theme.surface: the session's first frame matches the greeter's last
    // and the splash (one colour at every cut, DESIGN.md "Arrival").
    backdrop-color "{{colors.surface.default.hex}}"
}
