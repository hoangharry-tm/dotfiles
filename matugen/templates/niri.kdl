// Generated by matugen from {{image}}. Do not edit; see ~/.config/matugen.
layout {
    // Focus ring: secondary = the wallpaper hue with the chroma pulled down
    // (calmer than primary, which stays for state); cc = 80 % so it reads as
    // an edge catching light, not a drawn line. One ring on screen only.
    focus-ring {
        active-color "{{colors.secondary.default.hex}}cc"
        inactive-color "#00000000"
        urgent-color "{{colors.error.default.hex}}"
    }
    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
    }
    insert-hint {
        color "{{colors.primary.default.hex}}60"
    }
}

overview {
    // = Theme.surface: the session's first frame matches the greeter's last
    // and the splash (one colour at every cut, DESIGN.md "Arrival").
    backdrop-color "{{colors.surface.default.hex}}"
}
