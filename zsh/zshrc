# Powerlevel10k instant prompt. Must stay close to the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================
#  HISTORY
# ============================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt BANG_HIST
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# ============================================================
#  OH MY ZSH
# ============================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode auto

# Cache dir for compdump and generated init scripts
_zc="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"; [[ -d $_zc ]] || mkdir -p "$_zc"

# Why: omz runs compinit (+ compaudit) on every start. Skip the security audit
# (nix store is read-only) and reuse the dump (-C) when it is under 24h old.
ZSH_DISABLE_COMPFIX=true
ZSH_COMPDUMP="$_zc/zcompdump-${ZSH_VERSION}"
compinit() {
  unfunction compinit; autoload -Uz compinit
  local -a fresh=( $ZSH_COMPDUMP(Nmh-24) )
  if (( $#fresh )); then compinit -C -d "$ZSH_COMPDUMP"; else compinit -u -d "$ZSH_COMPDUMP"; fi
}

# Docker completions (add before OMZ compinit runs)
fpath=("$HOME/.docker/completions" $fpath)

# zsh-vi-mode: leave insert mode with `jk` (Esc still works too)
ZVM_VI_INSERT_ESCAPE_BINDKEY=jk

plugins=(
  zsh-vi-mode
  git
  web-search
  virtualenv
  extract
  colored-man-pages
  copyfile
  copypath
  gh
)
[[ "$OSTYPE" == darwin* ]] && plugins+=(macos)

source $ZSH/oh-my-zsh.sh

# Why: highlighting/suggestions are not needed for the first prompt; load them
# after it via zsh-defer (Nix-provided; plain sync load where it is absent).
# Highlighting must load last so it wraps every widget.
if [[ -r ${_zd:=$ZSH_CUSTOM/plugins/zsh-defer/zsh-defer.plugin.zsh} ]]; then
  source $_zd
  _late() { [[ -r $ZSH_CUSTOM/plugins/$1/$1.plugin.zsh ]] && zsh-defer source $ZSH_CUSTOM/plugins/$1/$1.plugin.zsh }
else
  _late() { [[ -r $ZSH_CUSTOM/plugins/$1/$1.plugin.zsh ]] && source $ZSH_CUSTOM/plugins/$1/$1.plugin.zsh }
fi
_late zsh-autosuggestions
_late zsh-syntax-highlighting

# ============================================================
#  TOOL INIT
# ============================================================
# Why: `tool init` forks are slow; cache the output, keyed by the binary's
# store dir (and mtime off Nix) so upgrades regenerate it.
_cache_init() { # _cache_init <tool> <args...>
  local bin=${commands[$1]:-$(whence -p $1)}  # fallback: hash may be cold under zvm
  local out="$_zc/${1}-${(j:-:)@[2,-1]}-${${bin:A}:h:h:t}.zsh"
  [[ -n $bin ]] || return
  [[ -s $out && $out -nt $bin ]] || "$@" >| "$out" 2>/dev/null
  source "$out"
}
_cache_init zoxide init zsh
# fzf/atuin keybindings are set in zvm_after_init (see KEY BINDINGS),
# otherwise zsh-vi-mode overrides them

# ============================================================
#  SHELL OPTIONS
# ============================================================
setopt AUTO_CD
setopt AUTO_LIST
setopt AUTO_MENU
setopt ALWAYS_TO_END
setopt MENU_COMPLETE
setopt COMPLETE_IN_WORD
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt NO_HUP
setopt NO_LIST_BEEP
setopt HASH_LIST_ALL

# ============================================================
#  KEY BINDINGS
# ============================================================
# zsh-vi-mode resets keybindings on init, so custom bindings go here
zvm_after_init() {
  _cache_init fzf --zsh
  _cache_init atuin init zsh
  bindkey '^[[A' up-line-or-search
  bindkey '^[[B' down-line-or-search
  bindkey '^[[H' beginning-of-line
  bindkey '^[[F' end-of-line
  bindkey '^[[3~' delete-char
}
export KEYTIMEOUT=1

