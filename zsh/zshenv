# Keep PATH entries unique (later additions of an existing dir are dropped)
typeset -U path PATH

# Nix: put Nix-installed tools on PATH. bash gets this via /etc/profile, but
# zsh (Nix's build in particular) doesn't read it. Clear the script's
# "already sourced" guard: it can be inherited without the PATH it set, and
# re-sourcing is harmless since PATH is unique (above).
unset __ETC_PROFILE_NIX_SOURCED
for f in /etc/profile.d/nix-daemon.sh /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh; do
  [ -e "$f" ] && { . "$f"; break; }
done
unset f

# Home Manager session variables
[ -e "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ] && . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
