// fastfetch: minimal, lowercase, no icons (Muji). Colours come from the `ff`
// wrapper (hh-nix-config, modules/programs/fastfetch.nix) via matugen; run
// plainly (macOS) it falls back to the terminal's ANSI palette.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "left": 2, "right": 3 } },
  "display": {
    "separator": "  ",
    "key": { "type": "string", "width": 8 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "break",
    { "type": "os", "key": "os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "shell", "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "format": "{pretty-name}" },
    { "type": "packages", "key": "pkgs", "format": "{all}" },
    { "type": "memory", "key": "mem", "format": "{used} / {total}" },
    { "type": "uptime", "key": "up", "format": "{days}d {hours}h {minutes}m" }
  ]
}
